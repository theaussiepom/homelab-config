# Private project environment; no production values.

# Required deployment addresses for the public source configuration.
HOMELAB_DATABASE_DB_BACKUP_DNS_1=
HOMELAB_DATABASE_DB_BACKUP_DNS_2=
HOMELAB_DATABASE_DB_BACKUP_IPV4_ADDRESS_1=
HOMELAB_DATABASE_INFLUXDB_IPV4_ADDRESS_1=
HOMELAB_DATABASE_PGADMIN_PGADMIN_CONFIG_DEFAULT_SERVER_1=
HOMELAB_DATABASE_PHPMYADMIN_IPV4_ADDRESS_1=

# Additional private application inputs.
HOMELAB_PMA_SSL_WARNING_SAFE_HOSTS_JSON=

# Split source roots and private assembled inputs. Example paths only.
HOMELAB_AUTOMATION_COMPOSE_FILE=/srv/private/runtime/automation_compose_file
HOMELAB_CONFIG_ROOT=/srv/source/homelab-config
HOMELAB_DATABASE_COMPOSE_FILE=/srv/private/runtime/database_compose_file
HOMELAB_IMPLEMENTATION_ROOT=/srv/source/homelab
HOMELAB_RECOVERY_MANIFEST_FILE=/srv/private/runtime/recovery_manifest_file
HOMELAB_STORAGE_RECOVERY_FILE=/srv/private/runtime/storage_recovery_file
