# Private project environment; no production values.

# Required deployment addresses for the public source configuration.
HOMELAB_NETWORK_NEBULA_SYNC_IPV4_ADDRESS_1=
HOMELAB_NETWORK_NTP_IPV4_ADDRESS_1=
HOMELAB_NETWORK_PIHOLE_IPV4_ADDRESS_1=
HOMELAB_NETWORK_PIHOLE_IPV4_ADDRESS_2=
HOMELAB_NETWORK_PIHOLE_IP_RANGE_1=
HOMELAB_NETWORK_PIHOLE_SUBNET_1=
HOMELAB_NETWORK_SHARED_O_1=
HOMELAB_NETWORK_TRAEFIK_IPV4_ADDRESS_1=
HOMELAB_NETWORK_UNBOUND_IPV4_ADDRESS_1=
HOMELAB_NETWORK_UNDERGROUND_GATEWAY_1=
HOMELAB_NETWORK_UNDERGROUND_IP_RANGE_1=
HOMELAB_NETWORK_UNDERGROUND_SUBNET_1=

# Private inputs passed to the application.
HOMELAB_TRAEFIK_LOCAL_0_1=
HOMELAB_TRAEFIK_LOCAL_1_1=
HOMELAB_TRAEFIK_LOCAL_2_1=
HOMELAB_TRAEFIK_LOCAL_3_1=
HOMELAB_TRAEFIK_LOCAL_4_1=
HOMELAB_TRAEFIK_LOCAL_5_1=
HOMELAB_TRAEFIK_SECURITY_HEADERS_THREADLENS_CONTENTSECURITYPOLICY_1=

# Private Unbound local DNS records; bind source must already exist.
HOMELAB_UNBOUND_LOCAL_RECORDS_FILE=

# Split source roots and private assembled inputs. Example paths only.
HOMELAB_TRAEFIK_DYNAMIC_DIR=/srv/private/runtime/traefik_dynamic_dir
HOMELAB_TRAEFIK_STATIC_FILE=/srv/private/runtime/traefik_static_file
